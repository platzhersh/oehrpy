---
import GithubIcon from "./GithubIcon.astro";
import Logo from "./Logo.astro";
import { packageVersion } from "../utils/version";

// The one copy of the site navigation. Before the Astro migration every
// page carried its own hand-edited <header>, and the nav order had
// already drifted between pages (Workflow sat before "Tools" on some and
// after it on others). The desktop header *styling* still comes from each
// page's own stylesheet (src/styles/pages/*.css), which is why the markup
// below keeps the exact class names those stylesheets target. The mobile
// (responsive) header rules live only in the <style> block at the bottom
// of this file, so every page wraps the nav the same way.
export type NavPage =
  | "home"
  | "docs"
  | "validator"
  | "converter"
  | "explorer"
  | "workflow"
  | "vscode"
  | "brand-kit"
  /** No nav entry is current (e.g. the 404 page). */
  | "none";

interface Props {
  active: NavPage;
  /** Show the package version badge (used by the in-browser tool pages). */
  showVersion?: boolean;
  /** Pixel size of the header logo mark. */
  logoSize?: number;
}

const { active, showVersion = false, logoSize = 32 } = Astro.props;
const tools: { page: NavPage; href: string; label: string }[] = [
  { page: "validator", href: "/validator.html", label: "Validator" },
  { page: "converter", href: "/converter.html", label: "Converter" },
  { page: "explorer", href: "/explorer.html", label: "Explorer" },
];
const toolActive = tools.some((t) => t.page === active);
const cls = (page: NavPage) => (page === active ? "active" : undefined);
---
<header class="site-header">
  <a href="/" class="logo-header">
    <Logo size={logoSize} />
    <span>oehrpy</span>
  </a>
  <nav>
    {active === "home" ? (
      <>
        <a href="#features">Features</a>
        <a href="#quickstart">Quick Start</a>
      </>
    ) : (
      <a href="/" class="nav-home">Home</a>
    )}
    <a href="/docs.html" class={cls("docs")}>Docs</a>
    <div class="nav-dropdown">
      <button class:list={["nav-dropdown-btn", { active: toolActive }]} aria-expanded="false" aria-controls="nav-tools-menu">Tools <span class="dropdown-arrow">&#9662;</span></button>
      <div class="nav-dropdown-menu" id="nav-tools-menu">
        {tools.map((t) => <a href={t.href} class={cls(t.page)}>{t.label}</a>)}
      </div>
    </div>
    <a href="/workflow.html" class={cls("workflow")}>Workflow</a>
    <a href="/vscode.html" class={cls("vscode")}>VS Code</a>
    <a href="/brand-kit.html" class={cls("brand-kit")}>Brand Kit</a>
    {showVersion && <span class="badge" id="version-badge">v{packageVersion}</span>}
    <a href="https://github.com/platzhersh/oehrpy" class="github-link" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
      <GithubIcon />
      <span class="github-label">GitHub</span>
    </a>
  </nav>
</header>

<style is:global>
  /* Responsive header, shared by every page. Selectors are prefixed with
     .site-header so they outrank the per-page desktop rules (`header nav`,
     `.github-link`, ...) regardless of stylesheet order. Nothing here
     applies above 768px, so the desktop header is untouched. */
  @media (max-width: 768px) {
    .site-header {
      padding: 16px 20px;
      flex-wrap: wrap;
      gap: 12px 16px;
    }
    .site-header nav {
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px 16px;
      margin-left: 0;
      min-width: 0;
    }
    .site-header nav a:not(.github-link),
    .site-header .nav-dropdown-btn {
      font-size: 14px;
    }
    /* The logo already links home. */
    .site-header .nav-home {
      display: none;
    }
    .site-header .github-link {
      padding: 6px 10px;
      font-size: 14px;
    }
    .site-header .github-label {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .site-header {
      padding: 12px 16px;
    }
    .site-header nav {
      gap: 10px 12px;
    }
    .site-header .logo-header span {
      font-size: 20px;
    }
  }
</style>

<script>
  // Nav "Tools" dropdown: click to toggle, click outside or Escape to close.
  const dropdown = document.querySelector<HTMLElement>(".nav-dropdown");
  const btn = dropdown?.querySelector<HTMLButtonElement>(".nav-dropdown-btn");
  if (dropdown && btn) {
    const setOpen = (open: boolean) => {
      dropdown.classList.toggle("is-open", open);
      btn.setAttribute("aria-expanded", open ? "true" : "false");
    };
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      setOpen(!dropdown.classList.contains("is-open"));
    });
    document.addEventListener("click", (e) => {
      if (!dropdown.contains(e.target as Node)) setOpen(false);
    });
    dropdown.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        setOpen(false);
        btn.focus();
      }
    });
  }
</script>
