---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/pages/validator.css";
---
<Layout
  title={"oehrpy · Validator"}
  description={"Validate openEHR FLAT-format compositions and OPT templates in your browser with the oehrpy validator."}
  path="validator.html"
  twitterDescription={"Validate openEHR FLAT-format compositions and OPT templates in your browser."}
>
<div class="app">

  <!-- Header -->
  <SiteHeader active="validator" showVersion={true} />

  <h1 style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;">oehrpy Validator — validate openEHR FLAT compositions and OPT templates</h1>

  <!-- Mode bar -->
  <div class="mode-bar">
    <span class="mode-label">Mode</span>
    <div class="mode-toggle">
      <button class="mode-btn active" id="btn-mode-flat" onclick="setMode('flat')">FLAT Composition</button>
      <button class="mode-btn" id="btn-mode-opt" onclick="setMode('opt')">OPT Template</button>
      <button class="mode-btn" id="btn-mode-migration" onclick="setMode('migration')">Platform Migration</button>
    </div>
    <span class="mode-desc" id="mode-desc">Validate FLAT compositions against Web Templates</span>
  </div>

  <!-- Platform bar -->
  <div class="platform-bar" id="platform-bar">
    <span class="platform-label">Platform</span>
    <div class="platform-toggle">
      <button class="platform-btn active" id="btn-ehrbase" onclick="setPlatform('ehrbase')">EHRBase 2.x</button>
      <button class="platform-btn" id="btn-better" onclick="setPlatform('better')">Better</button>
    </div>
    <span class="platform-hint" id="platform-hint">no :0 indexing · tree.id prefix · direct paths</span>
  </div>

  <!-- Migration platform bar -->
  <div class="platform-bar" id="migration-platform-bar" style="display: none;">
    <span class="platform-label">Source</span>
    <div class="platform-toggle">
      <button class="platform-btn active" id="btn-migration-ehrbase" onclick="setMigrationSource('ehrbase')">EHRBase 2.x</button>
      <button class="platform-btn" id="btn-migration-better" onclick="setMigrationSource('better')">Better</button>
    </div>
    <span class="platform-label" style="margin-left: 16px;">&rarr;</span>
    <span class="platform-label" style="margin-left: 16px;">Target</span>
    <div class="platform-toggle">
      <button class="platform-btn" id="btn-migration-target-ehrbase">EHRBase 2.x</button>
      <button class="platform-btn active" id="btn-migration-target-better">Better</button>
    </div>
    <button class="load-example-btn" style="margin-left: auto; font-size: 11px; padding: 4px 10px;" onclick="swapMigrationPlatforms()">Swap &#8644;</button>
    <button class="load-example-btn" style="font-size: 11px; padding: 4px 10px;" onclick="autoDetectPlatform()">Auto-detect</button>
  </div>

  <!-- Action bar -->
  <div class="action-bar">
    <button class="validate-btn" id="validate-btn" onclick="runValidation()">
      Validate
      <span class="shortcut">Ctrl+Enter</span>
    </button>
    <div class="status-pill idle" id="status-pill">
      <div class="status-dot"></div>
      <span id="status-text">Waiting for input</span>
    </div>
    <span class="stats" id="stats-text"></span>
    <button class="explorer-toggle" id="explorer-toggle" onclick="toggleExplorer()" style="display:none">
      Show valid paths
    </button>
    <button class="load-example-btn" onclick="currentMode === 'opt' ? loadOPTExample() : currentMode === 'migration' ? loadMigrationExample() : loadExample()">Load example</button>
  </div>

  <!-- Main panels -->
  <main>
    <!-- FLAT mode panels -->
    <div class="panel flat-panel" style="border-bottom: 1px solid var(--border);">
      <div class="panel-header">
        <span class="panel-title">Web Template</span>
        <span class="panel-count" id="wt-count"></span>
        <button class="clear-btn" onclick="document.getElementById('wt-input').value='';updateCounts()">clear</button>
      </div>
      <textarea id="wt-input" placeholder='Paste your Web Template JSON here...

Fetch from EHRBase:
GET /rest/openehr/v1/definition/template/adl1.4/&#123;template_id&#125;

The validator reads the "tree" structure to enumerate
all valid FLAT paths for your template.' spellcheck="false" oninput="updateCounts()"></textarea>
    </div>

    <div class="panel flat-panel" style="border-bottom: 1px solid var(--border);">
      <div class="panel-header">
        <span class="panel-title">FLAT Composition</span>
        <span class="panel-count" id="flat-count"></span>
        <button class="clear-btn" onclick="document.getElementById('flat-input').value='';updateCounts()">clear</button>
      </div>
      <textarea id="flat-input" placeholder='Paste your FLAT composition JSON here...

Example paths (EHRBase 2.x):
  "adverse_reaction_list/category|code": "433",
  "adverse_reaction_list/adverse_reaction/causative_agent|value": "Penicillin",
  "adverse_reaction_list/adverse_reaction/causative_agent|code": "372687004",
  "adverse_reaction_list/adverse_reaction/causative_agent|terminology": "SNOMED-CT"' spellcheck="false" oninput="updateCounts()"></textarea>
    </div>

    <!-- OPT mode panel -->
    <div class="panel opt-panel" style="grid-column: 1 / -1; border-bottom: 1px solid var(--border); display: none;">
      <div class="panel-header">
        <span class="panel-title">OPT Template (XML)</span>
        <span class="panel-count" id="opt-count"></span>
        <button class="clear-btn" onclick="document.getElementById('opt-input').value='';updateCounts()">clear</button>
      </div>
      <textarea id="opt-input" placeholder='Paste your OPT 1.4 XML here...

<?xml version="1.0" encoding="UTF-8"?>
<template xmlns="http://schemas.openehr.org/v1">
  <language>...</language>
  <description>...</description>
  <definition>...</definition>
  <ontology>...</ontology>
</template>

The validator checks well-formedness, semantic integrity,
and structural quality. FLAT path hints are informational only;
authoritative FLAT paths come from the Web Template (ADR-0005).' spellcheck="false" oninput="updateCounts()"></textarea>
    </div>

    <!-- Migration mode panels -->
    <div class="panel migration-panel" style="border-bottom: 1px solid var(--border); display: none;">
      <div class="panel-header">
        <span class="panel-title">Source Composition (FLAT)</span>
        <span class="panel-count" id="migration-source-count"></span>
        <button class="clear-btn" onclick="document.getElementById('migration-source').value='';updateCounts()">clear</button>
      </div>
      <textarea id="migration-source" placeholder='Paste your FLAT composition JSON here...' spellcheck="false" oninput="updateCounts()"></textarea>
    </div>

    <div class="panel migration-panel" style="border-bottom: 1px solid var(--border); display: none;">
      <div class="panel-header">
        <span class="panel-title">Converted Output</span>
        <span class="panel-count" id="migration-output-count"></span>
        <button class="clear-btn" onclick="copyMigrationOutput()">copy</button>
      </div>
      <textarea id="migration-output" readonly placeholder="Converted output will appear here..." spellcheck="false" style="opacity: 0.8; cursor: default;"></textarea>
    </div>

    <!-- Results spans both columns -->
    <div class="panel" style="grid-column: 1 / -1; border-right: none; border-top: 1px solid var(--border);">
      <div class="panel-header">
        <span class="panel-title" id="results-panel-title">Validation Results</span>
      </div>
      <div class="results-area" id="results-area">
        <div class="results-empty" id="results-empty">
          <div class="icon">&#9678;</div>
          <div>Paste a Web Template and a FLAT composition above, then click <strong>Validate</strong></div>
          <div style="opacity:0.5">or load an example to see the validator in action</div>
        </div>
      </div>
    </div>
  </main>

  <!-- Path Explorer (hidden initially) -->
  <div class="explorer-panel" id="explorer-panel">
    <div class="explorer-header">
      <span class="explorer-title">Valid Paths</span>
      <input type="text" class="explorer-search" id="explorer-search" placeholder="Filter paths..." oninput="filterPaths()">
    </div>
    <div class="explorer-list" id="explorer-list"></div>
  </div>

  <!-- Footer -->
  <footer>
    <span>Built with Python and openEHR</span>
    <span class="sep">|</span>
    <a href="https://github.com/platzhersh/oehrpy">GitHub</a>
    <span class="sep">|</span>
    <a href="docs.html">Docs</a>
    <span class="sep">|</span>
    <a href="https://openehr-explorer.dev/" target="_blank" rel="noopener noreferrer">openEHR Explorer</a>
    <span class="sep">|</span>
    <a href="https://github.com/platzhersh/open-cis" target="_blank" rel="noopener noreferrer">Open CIS</a>
    <span class="sep">|</span>
    <a href="brand-kit.html">Brand Kit</a>
    <span class="sep">|</span>
    <span>100% client-side</span>
    <span class="sep">|</span>
    <span class="engine-status" id="engine-status">
      <span class="engine-dot loading" id="engine-dot"></span>
      <span id="engine-label">Loading Python...</span>
    </span>
    <button class="retry-btn" id="retry-btn" onclick="retryPyodide()" style="display:none">Retry Python</button>
  </footer>

</div>

<!-- Loading overlay -->
<div class="loading-overlay" id="loading-overlay">
  <div class="loading-spinner"></div>
  <div class="loading-text" id="loading-text">Loading Python runtime...</div>
  <div class="loading-step" id="loading-step">~10 MB first load, cached afterwards</div>
</div>

<!-- Toast -->
<div class="toast" id="toast"></div>

<script is:inline>
// ============================================================
// === STATE ===
// ============================================================

var currentPlatform = 'ehrbase';
var currentMode = 'flat'; // 'flat' | 'opt' | 'migration'
var migrationSource = 'ehrbase';
var migrationTarget = 'better';
var validPathsCache = [];
var explorerOpen = false;

// Pyodide state
var pyodideReady = false;
var pyodideInstance = null;
var pyodideLoadFailed = false;
var pyodideTimedOut = false;
var oehrpyVersion = null;
var pythonVersion = null;
var engineMode = 'loading'; // 'loading' | 'python' | 'js'
var actualEngine = null; // Tracks which engine produced the last validation results

// ============================================================
// === PLATFORM ===
// ============================================================

var PLATFORM_HINTS = {
  ehrbase: 'no :0 indexing \u00b7 tree.id prefix \u00b7 direct paths',
  better:  ':0 indexing \u00b7 template_id prefix \u00b7 /any_event:0/'
};

function setPlatform(p) {
  currentPlatform = p;
  document.getElementById('btn-ehrbase').classList.toggle('active', p === 'ehrbase');
  document.getElementById('btn-better').classList.toggle('active', p === 'better');
  document.getElementById('platform-hint').textContent = PLATFORM_HINTS[p];
}

// ============================================================
// === MODE SWITCHING ===
// ============================================================

var MODE_DESCS = {
  flat: 'Validate FLAT compositions against Web Templates',
  opt:  'Validate OPT 1.4 XML files for well-formedness, semantics & structure',
  migration: 'Convert FLAT compositions between EHRBase and Better platform dialects'
};

function setMode(mode) {
  currentMode = mode;
  document.getElementById('btn-mode-flat').classList.toggle('active', mode === 'flat');
  document.getElementById('btn-mode-opt').classList.toggle('active', mode === 'opt');
  document.getElementById('btn-mode-migration').classList.toggle('active', mode === 'migration');
  document.getElementById('mode-desc').textContent = MODE_DESCS[mode];

  // Toggle panel visibility
  var flatPanels = document.querySelectorAll('.flat-panel');
  var optPanels = document.querySelectorAll('.opt-panel');
  var migrationPanels = document.querySelectorAll('.migration-panel');
  for (var i = 0; i < flatPanels.length; i++) flatPanels[i].style.display = mode === 'flat' ? '' : 'none';
  for (var j = 0; j < optPanels.length; j++) optPanels[j].style.display = mode === 'opt' ? '' : 'none';
  for (var m = 0; m < migrationPanels.length; m++) migrationPanels[m].style.display = mode === 'migration' ? '' : 'none';

  // Toggle platform bars
  document.getElementById('platform-bar').style.display = mode === 'flat' ? '' : 'none';
  document.getElementById('migration-platform-bar').style.display = mode === 'migration' ? '' : 'none';

  // Toggle explorer (only for FLAT)
  if (mode !== 'flat') {
    document.getElementById('explorer-toggle').style.display = 'none';
    var explorerPanel = document.getElementById('explorer-panel');
    explorerPanel.classList.remove('open');
    explorerOpen = false;
  }

  // Update validate button text
  var validateBtn = document.getElementById('validate-btn');
  validateBtn.childNodes[0].textContent = mode === 'migration' ? 'Convert ' : 'Validate ';

  // Update results panel title
  var resultsTitle = document.getElementById('results-panel-title');
  if (resultsTitle) {
    resultsTitle.textContent = mode === 'migration' ? 'Change Report' : 'Validation Results';
  }

  // Update grid layout: two columns for FLAT and migration, single for OPT
  var main = document.querySelector('main');
  main.style.gridTemplateColumns = (mode === 'flat' || mode === 'migration') ? '1fr 1fr' : '1fr';

  // Update empty state message
  var emptyHtml;
  if (mode === 'flat') {
    emptyHtml = '<div class="icon">&#9678;</div>' +
      '<div>Paste a Web Template and a FLAT composition above, then click <strong>Validate</strong></div>' +
      '<div style="opacity:0.5">or load an example to see the validator in action</div>';
  } else if (mode === 'opt') {
    emptyHtml = '<div class="icon">&#9678;</div>' +
      '<div>Paste an OPT 1.4 XML template above, then click <strong>Validate</strong></div>' +
      '<div style="opacity:0.5">or load an example to see the validator in action</div>';
  } else {
    emptyHtml = '<div class="icon">&#8644;</div>' +
      '<div>Paste a FLAT composition above, then click <strong>Convert</strong></div>' +
      '<div style="opacity:0.5">or load an example to see platform migration in action</div>';
  }

  // Reset results
  document.getElementById('results-area').innerHTML =
    '<div class="results-empty" id="results-empty">' + emptyHtml + '</div>';
  showStatus('idle', 'Waiting for input');
  document.getElementById('stats-text').textContent = '';
}

// ============================================================
// === PYODIDE BOOTSTRAP ===
// ============================================================

var PYODIDE_CDN = 'https://cdn.jsdelivr.net/pyodide/v0.27.1/full/';
var PYODIDE_TIMEOUT = 30000;

function getRequestedVersion() {
  var params = new URLSearchParams(window.location.search);
  return params.get('version') || null;
}

function setLoadingStep(text) {
  var el = document.getElementById('loading-text');
  if (el) el.textContent = text;
}

function hideLoadingOverlay() {
  var overlay = document.getElementById('loading-overlay');
  if (overlay) overlay.classList.add('hidden');
}

function updateEngineStatus(mode, label) {
  engineMode = mode;
  var dot = document.getElementById('engine-dot');
  var labelEl = document.getElementById('engine-label');
  dot.className = 'engine-dot ' + mode;
  labelEl.textContent = label;

  var retryBtn = document.getElementById('retry-btn');
  retryBtn.style.display = (mode === 'js') ? 'inline-block' : 'none';
}

function showToast(message, type, duration) {
  var toast = document.getElementById('toast');
  toast.textContent = message;
  toast.className = 'toast show' + (type ? ' ' + type : '');
  if (duration !== 0) {
    setTimeout(function() { toast.className = 'toast'; }, duration || 6000);
  }
}

// Look up the pure-Python wheel of a PyPI project (latest release, or the
// given version) via PyPI's JSON API, which allows cross-origin requests.
async function findPureWheelUrl(project, version) {
  var url = 'https://pypi.org/pypi/' + project + '/' + (version ? encodeURIComponent(version) + '/' : '') + 'json';
  var resp = await fetch(url);
  if (!resp.ok) {
    throw new Error('PyPI lookup failed for ' + project + (version ? '==' + version : '') + ' (HTTP ' + resp.status + ')');
  }
  var data = await resp.json();
  var wheel = (data.urls || []).find(function(f) {
    return f.packagetype === 'bdist_wheel' && /-none-any\.whl$/.test(f.filename);
  });
  if (!wheel) throw new Error('No pure-Python wheel on PyPI for ' + project + ' ' + data.info.version);
  return wheel.url;
}

async function initPyodide() {
  setLoadingStep('Loading Python runtime...');
  updateEngineStatus('loading', 'Loading Python...');
  pyodideTimedOut = false;

  var timeoutId = setTimeout(function() {
    if (!pyodideReady) {
      console.warn('Pyodide load timed out after ' + PYODIDE_TIMEOUT + 'ms');
      pyodideTimedOut = true;
      fallbackToJS('Timeout: Python runtime took too long to load');
    }
  }, PYODIDE_TIMEOUT);

  try {
    // Load Pyodide
    pyodideInstance = await loadPyodide({ indexURL: PYODIDE_CDN });
    if (pyodideTimedOut) return;

    setLoadingStep('Installing oehrpy...');

    // Install oehrpy. oehrpy pins exact dependency versions
    // (pydantic==2.13.4 -> pydantic-core==2.46.4), but pydantic-core is a
    // compiled extension and Pyodide can only use the WebAssembly build it
    // ships itself, so resolving the pins always fails in the browser. So:
    // load Pyodide's bundled pydantic, then load the oehrpy and defusedxml
    // wheels straight from PyPI by URL. loadPackage() installs a wheel URL
    // without resolving its dependencies. micropip is deliberately not used:
    // the micropip bundled with Pyodide 0.27 (0.8.0) never awaits the wheel
    // download when deps=False and fails with "attempted to install wheel
    // before downloading it". httpx is only needed by the EHRBase client.
    await pyodideInstance.loadPackage('pydantic');
    if (pyodideTimedOut) return;

    var requestedVersion = getRequestedVersion();
    var wheelUrls = await Promise.all([
      findPureWheelUrl('oehrpy', requestedVersion),
      findPureWheelUrl('defusedxml', null)
    ]);
    if (pyodideTimedOut) return;
    await pyodideInstance.loadPackage(wheelUrls);
    if (pyodideTimedOut) return;

    setLoadingStep('Importing validation module...');

    // Import and verify
    await pyodideInstance.runPythonAsync(
      'from oehrpy.validation import FlatValidator\n' +
      'from oehrpy.validation.opt import OPTValidator\n' +
      'import json\n' +
      'import oehrpy\n'
    );
    if (pyodideTimedOut) return;

    // Get version info
    oehrpyVersion = await pyodideInstance.runPythonAsync(
      'oehrpy.__version__ if hasattr(oehrpy, "__version__") else "unknown"'
    );
    if (pyodideTimedOut) return;

    pythonVersion = await pyodideInstance.runPythonAsync(
      'import sys; f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}"'
    );
    if (pyodideTimedOut) return;

    clearTimeout(timeoutId);
    pyodideReady = true;
    pyodideLoadFailed = false;

    hideLoadingOverlay();
    updateEngineStatus('python', 'Python ' + pythonVersion + ' \u00b7 oehrpy ' + oehrpyVersion);
    document.getElementById('validate-btn').disabled = false;
    var vBadge = document.getElementById('version-badge');
    if (vBadge && oehrpyVersion && oehrpyVersion !== 'unknown') {
      vBadge.textContent = 'v' + oehrpyVersion;
    }

    console.log('Pyodide ready: Python ' + pythonVersion + ', oehrpy ' + oehrpyVersion);

  } catch (err) {
    clearTimeout(timeoutId);
    if (pyodideTimedOut) return;
    console.error('Pyodide initialization failed:', err);
    fallbackToJS(err.message || String(err));
  }
}

function fallbackToJS(reason) {
  pyodideLoadFailed = true;
  pyodideReady = false;
  hideLoadingOverlay();
  updateEngineStatus('js', 'JS fallback');
  document.getElementById('validate-btn').disabled = false;
  showToast('Python runtime unavailable \u2014 using built-in validator (may differ from SDK)', 'warn', 8000);
  console.warn('Falling back to JS engine. Reason:', reason);
}

function retryPyodide() {
  pyodideLoadFailed = false;
  pyodideTimedOut = false;
  document.getElementById('loading-overlay').classList.remove('hidden');
  document.getElementById('loading-step').textContent = 'Retrying...';
  initPyodide();
}

// ============================================================
// === PYTHON BRIDGE ===
// ============================================================

async function runPythonValidation(wtJson, flatObj, platform) {
  // Safely serialize JSON for embedding in Python string
  var wtStr = JSON.stringify(wtJson);
  var flatStr = JSON.stringify(flatObj);

  // Use Pyodide globals to pass data safely (avoids string escaping issues)
  pyodideInstance.globals.set('_wt_json_str', wtStr);
  pyodideInstance.globals.set('_flat_json_str', flatStr);
  pyodideInstance.globals.set('_platform', platform);

  var resultStr = await pyodideInstance.runPythonAsync(
    'import json\n' +
    'from oehrpy.validation import FlatValidator\n' +
    '\n' +
    '_wt = json.loads(_wt_json_str)\n' +
    '_flat = json.loads(_flat_json_str)\n' +
    '\n' +
    '_validator = FlatValidator.from_web_template(_wt, platform=_platform)\n' +
    '_result = _validator.validate(_flat)\n' +
    '_valid_paths = _validator.valid_paths\n' +
    '\n' +
    'json.dumps({\n' +
    '    "is_valid": _result.is_valid,\n' +
    '    "errors": [\n' +
    '        {\n' +
    '            "path": e.path,\n' +
    '            "error_type": e.error_type,\n' +
    '            "message": e.message,\n' +
    '            "suggestion": e.suggestion,\n' +
    '            "valid_alternatives": e.valid_alternatives,\n' +
    '        }\n' +
    '        for e in _result.errors\n' +
    '    ],\n' +
    '    "warnings": [\n' +
    '        {\n' +
    '            "path": w.path,\n' +
    '            "error_type": w.error_type,\n' +
    '            "message": w.message,\n' +
    '            "suggestion": w.suggestion,\n' +
    '        }\n' +
    '        for w in _result.warnings\n' +
    '    ],\n' +
    '    "valid_path_count": _result.valid_path_count,\n' +
    '    "checked_path_count": _result.checked_path_count,\n' +
    '    "template_id": _result.template_id,\n' +
    '    "valid_paths": _valid_paths,\n' +
    '})\n'
  );

  return JSON.parse(resultStr);
}

// ============================================================
// === OPT PYTHON BRIDGE ===
// ============================================================

async function runOPTValidation(xmlContent) {
  pyodideInstance.globals.set('_opt_xml', xmlContent);

  var resultStr = await pyodideInstance.runPythonAsync(
    'import json\n' +
    'from oehrpy.validation.opt import OPTValidator\n' +
    '\n' +
    '_validator = OPTValidator()\n' +
    '_result = _validator.validate_string(_opt_xml)\n' +
    '\n' +
    'json.dumps({\n' +
    '    "is_valid": _result.is_valid,\n' +
    '    "template_id": _result.template_id,\n' +
    '    "concept": _result.concept,\n' +
    '    "node_count": _result.node_count,\n' +
    '    "archetype_count": _result.archetype_count,\n' +
    '    "error_count": _result.error_count,\n' +
    '    "warning_count": _result.warning_count,\n' +
    '    "issues": [\n' +
    '        {\n' +
    '            "severity": i.severity,\n' +
    '            "category": i.category,\n' +
    '            "code": i.code,\n' +
    '            "message": i.message,\n' +
    '            "xpath": i.xpath,\n' +
    '            "node_id": i.node_id,\n' +
    '            "archetype_id": i.archetype_id,\n' +
    '            "suggestion": i.suggestion,\n' +
    '        }\n' +
    '        for i in _result.issues\n' +
    '    ],\n' +
    '})\n'
  );

  return JSON.parse(resultStr);
}

// ============================================================
// === JS FALLBACK ENGINE (kept from v0.2.0) ===
// ============================================================

var REQUIRED_SUFFIXES = {
  DV_QUANTITY: ['|magnitude', '|unit'],
  DV_CODED_TEXT: ['|value', '|code', '|terminology'],
  DV_TEXT: [],
  DV_DATE_TIME: [],
  DV_DATE: [],
  DV_TIME: [],
  DV_BOOLEAN: [],
  DV_COUNT: ['|magnitude'],
  DV_ORDINAL: ['|value', '|code', '|terminology', '|ordinal'],
  DV_PROPORTION: ['|numerator', '|denominator', '|type'],
  DV_DURATION: [],
  DV_IDENTIFIER: ['|id', '|type', '|issuer', '|assigner'],
  DV_URI: [],
  CODE_PHRASE: ['|code', '|terminology']
};

var VALID_SUFFIXES = {
  DV_QUANTITY: ['|magnitude', '|unit', '|precision', '|normal_range', '|normal_status'],
  DV_CODED_TEXT: ['|value', '|code', '|terminology', '|preferred_term'],
  DV_TEXT: ['|value'],
  DV_DATE_TIME: [],
  DV_DATE: [],
  DV_TIME: [],
  DV_BOOLEAN: [],
  DV_COUNT: ['|magnitude', '|accuracy', '|accuracy_is_percent'],
  DV_ORDINAL: ['|value', '|code', '|terminology', '|ordinal'],
  DV_SCALE: ['|value', '|code', '|terminology', '|symbol_value'],
  DV_PROPORTION: ['|numerator', '|denominator', '|type', '|precision'],
  DV_DURATION: [],
  DV_IDENTIFIER: ['|id', '|type', '|issuer', '|assigner'],
  DV_URI: [],
  DV_EHR_URI: [],
  DV_MULTIMEDIA: ['|mediatype', '|alternatetext', '|uri', '|size'],
  DV_PARSABLE: ['|value', '|formalism'],
  CODE_PHRASE: ['|code', '|terminology'],
  PARTY_IDENTIFIED: ['|name', '|id'],
  PARTY_RELATED: ['|name', '|id', '|relationship'],
  PARTY_SELF: []
};

var STRUCTURAL_RM_TYPES = {
  COMPOSITION: true, SECTION: true, OBSERVATION: true, EVALUATION: true,
  INSTRUCTION: true, ACTION: true, ADMIN_ENTRY: true, CLUSTER: true,
  HISTORY: true, EVENT: true, POINT_EVENT: true, INTERVAL_EVENT: true,
  ITEM_TREE: true, ITEM_LIST: true, ITEM_SINGLE: true, ITEM_TABLE: true,
  ELEMENT: true, EVENT_CONTEXT: true, ACTIVITY: true, ISM_TRANSITION: true,
  INSTRUCTION_DETAILS: true
};

var REQUIRED_COMPOSITION_FIELDS = [
  ['category|code', 'category|value', 'category|terminology'],
  ['language|code'],
  ['language|terminology'],
  ['territory|code'],
  ['territory|terminology'],
  ['composer|name'],
  ['context/start_time']
];

function parseWebTemplate(wtJson) {
  var paths = new Map();
  var treeId = wtJson.tree ? wtJson.tree.id || '' : '';
  var templateId = wtJson.templateId || wtJson.template_id || treeId;

  function traverse(node, prefix) {
    if (!node) return;
    var nodeId = node.id || '';
    var currentPath = prefix ? prefix + '/' + nodeId : nodeId;
    var rmType = node.rmType || node.rm_type || '';
    var nodeInfo = {
      id: nodeId,
      name: node.name || nodeId,
      rmType: rmType,
      aqlPath: node.aqlPath || '',
      originalName: null
    };

    if (node.localizedNames) {
      var localName = node.localizedNames['en'] || Object.values(node.localizedNames)[0];
      if (localName && localName.toLowerCase().replace(/[\s/]+/g, '_').replace(/[^a-z0-9_]/g, '') !== nodeId) {
        nodeInfo.originalName = localName;
      }
    }

    if (!nodeInfo.originalName && node.originalName) {
      var origSlug = node.originalName.toLowerCase().replace(/[\s/]+/g, '_').replace(/[^a-z0-9_]/g, '');
      if (origSlug !== nodeId) {
        nodeInfo.originalName = node.originalName;
      }
    }

    paths.set(currentPath, nodeInfo);

    if (node.children && node.children.length > 0) {
      for (var i = 0; i < node.children.length; i++) {
        traverse(node.children[i], currentPath);
      }
    }
  }

  if (wtJson.tree) {
    traverse(wtJson.tree, '');
  }

  return { treeId: treeId, templateId: templateId, paths: paths };
}

function enumerateValidPaths(parsedTemplate, platform) {
  var result = [];
  var paths = parsedTemplate.paths;

  paths.forEach(function(nodeInfo, path) {
    var rmType = nodeInfo.rmType;

    // Skip structural RM types — they are intermediate, not leaf paths
    if (STRUCTURAL_RM_TYPES[rmType]) {
      return;
    }

    var suffixes = VALID_SUFFIXES[rmType];

    if (suffixes === undefined) {
      // Unknown RM type — accept the bare path
      result.push({ path: path, rmType: rmType, name: nodeInfo.name, isLeaf: true });
    } else if (suffixes.length === 0) {
      result.push({ path: path, rmType: rmType, name: nodeInfo.name, isLeaf: true });
    } else {
      for (var i = 0; i < suffixes.length; i++) {
        result.push({ path: path + suffixes[i], rmType: rmType, name: nodeInfo.name, isLeaf: true });
      }
      result.push({ path: path, rmType: rmType, name: nodeInfo.name, isLeaf: true });
    }

    if (platform === 'better') {
      var indexedPath = path.replace(/\/([^/]+)$/g, '/$1:0');
      if (indexedPath !== path) {
        result.push({ path: indexedPath, rmType: rmType, name: nodeInfo.name, isLeaf: true });
        if (suffixes && suffixes.length > 0) {
          for (var j = 0; j < suffixes.length; j++) {
            result.push({ path: indexedPath + suffixes[j], rmType: rmType, name: nodeInfo.name, isLeaf: true });
          }
        }
      }
    }
  });

  return result;
}

function levenshtein(a, b) {
  var m = a.length, n = b.length;
  var dp = [];
  for (var i = 0; i <= m; i++) {
    dp[i] = [];
    for (var j = 0; j <= n; j++) {
      dp[i][j] = i === 0 ? j : j === 0 ? i : 0;
    }
  }
  for (var i2 = 1; i2 <= m; i2++)
    for (var j2 = 1; j2 <= n; j2++)
      dp[i2][j2] = a[i2-1] === b[j2-1] ? dp[i2-1][j2-1] : 1 + Math.min(dp[i2-1][j2], dp[i2][j2-1], dp[i2-1][j2-1]);
  return dp[m][n];
}

function findSuggestion(invalidPath, validPaths) {
  var stripped = invalidPath.replace(/\|[^|]+$/, '');
  var best = null, bestScore = Infinity;
  for (var i = 0; i < validPaths.length; i++) {
    var vp = validPaths[i];
    var vStripped = vp.path.replace(/\|[^|]+$/, '');
    var score = levenshtein(stripped, vStripped);
    if (score < bestScore) {
      bestScore = score;
      best = vp;
    }
  }
  if (best && bestScore < stripped.length * 0.6) {
    return { path: best.path, score: bestScore };
  }
  return null;
}

function validateFlatJS(flatObj, parsedTemplate, platform) {
  var errors = [];
  var warnings = [];
  var treeId = parsedTemplate.treeId;
  var paths = parsedTemplate.paths;
  var validPaths = enumerateValidPaths(parsedTemplate, platform);
  var validPathSet = new Set(validPaths.map(function(p) { return p.path; }));

  var checkedCount = 0;

  var keys = Object.keys(flatObj);
  for (var k = 0; k < keys.length; k++) {
    var key = keys[k];
    checkedCount++;
    if (!key.includes('/')) continue;
    if (validPathSet.has(key)) continue;

    var suggestion = findSuggestion(key, validPaths);
    var errorMsg = 'Path not found in Web Template.';

    if (platform === 'ehrbase' && /:\d+/.test(key)) {
      errorMsg = 'EHRBase 2.x does not use index notation (:0). Remove the index.';
    } else if (platform === 'better' && !/:\d+/.test(key)) {
      errorMsg = 'Better platform requires index notation (:0) on array paths.';
    } else if (key.includes('/any_event') && platform === 'ehrbase') {
      errorMsg = 'EHRBase 2.x does not include /any_event/ in FLAT paths. Use direct paths.';
    } else {
      paths.forEach(function(nodeInfo) {
        if (nodeInfo.originalName) {
          var originalSlug = nodeInfo.originalName.toLowerCase().replace(/[\s/]+/g, '_').replace(/[^a-z0-9_]/g, '');
          if (key.includes(originalSlug)) {
            errorMsg = 'Node was renamed in this template. Original name "' + nodeInfo.originalName + '" is now "' + nodeInfo.id + '".';
          }
        }
      });
    }

    errors.push({
      type: 'error',
      path: key,
      message: errorMsg,
      suggestion: suggestion ? suggestion.path : null
    });
  }

  // Check required fields
  var flatKeys = new Set(keys);
  for (var g = 0; g < REQUIRED_COMPOSITION_FIELDS.length; g++) {
    var group = REQUIRED_COMPOSITION_FIELDS[g];
    var found = false;
    for (var f = 0; f < group.length; f++) {
      if (flatKeys.has(treeId + '/' + group[f])) { found = true; break; }
    }
    if (!found) {
      warnings.push({
        type: 'warning',
        path: treeId + '/' + group[0],
        message: 'Required composition field is missing.',
        suggestion: null
      });
    }
  }

  return {
    errors: errors,
    warnings: warnings,
    checkedCount: checkedCount,
    validCount: checkedCount - errors.length,
    validPaths: validPaths
  };
}

// ============================================================
// === UI LAYER ===
// ============================================================

async function runValidation() {
  if (currentMode === 'opt') {
    return runOPTValidationFlow();
  }
  if (currentMode === 'migration') {
    return runMigrationFlow();
  }
  return runFlatValidationFlow();
}

async function runOPTValidationFlow() {
  var xmlRaw = document.getElementById('opt-input').value.trim();
  if (!xmlRaw) {
    showStatus('idle', 'Please provide an OPT XML template');
    return;
  }

  if (!pyodideReady) {
    showError('OPT validation requires the Python runtime. Please wait for it to load or retry.');
    return;
  }

  try {
    showStatus('idle', 'Validating OPT with Python...');
    actualEngine = 'python';
    var result = await runOPTValidation(xmlRaw);
    renderOPTResults(result);
  } catch (err) {
    console.error('OPT validation failed:', err);
    showError('OPT validation error: ' + (err.message || String(err)));
  }
}

async function runFlatValidationFlow() {
  var wtRaw = document.getElementById('wt-input').value.trim();
  var flatRaw = document.getElementById('flat-input').value.trim();

  if (!wtRaw || !flatRaw) {
    showStatus('idle', 'Please provide both Web Template and FLAT composition');
    return;
  }

  var wtJson, flatObj;
  try { wtJson = JSON.parse(wtRaw); } catch(e) {
    showError('Web Template JSON is invalid: ' + e.message); return;
  }
  try { flatObj = JSON.parse(flatRaw); } catch(e) {
    showError('FLAT Composition JSON is invalid: ' + e.message); return;
  }

  // Use Python engine if available, otherwise JS fallback
  if (pyodideReady) {
    try {
      showStatus('idle', 'Validating with Python...');
      var pyResult = await runPythonValidation(wtJson, flatObj, currentPlatform);

      // Normalize Python result to match the JS result format
      var result = {
        errors: pyResult.errors.map(function(e) {
          return { type: 'error', path: e.path, message: e.message, suggestion: e.suggestion };
        }),
        warnings: pyResult.warnings.map(function(w) {
          return { type: 'warning', path: w.path, message: w.message, suggestion: w.suggestion };
        }),
        checkedCount: pyResult.checked_path_count,
        validCount: pyResult.checked_path_count - pyResult.errors.length,
        validPaths: pyResult.valid_paths.map(function(p) {
          return { path: p, rmType: '', name: '' };
        })
      };

      actualEngine = 'python';
      validPathsCache = result.validPaths;
      renderResults(result);
      renderExplorer(result.validPaths);
      document.getElementById('explorer-toggle').style.display = 'block';
      return;

    } catch (err) {
      console.error('Python validation failed, falling back to JS:', err);
      showToast('Python validation error \u2014 using JS fallback', 'warn', 5000);
    }
  }

  // JS fallback
  actualEngine = 'js';
  var parsedTemplate = parseWebTemplate(wtJson);
  var result = validateFlatJS(flatObj, parsedTemplate, currentPlatform);
  validPathsCache = result.validPaths;

  renderResults(result);
  renderExplorer(result.validPaths);
  document.getElementById('explorer-toggle').style.display = 'block';
}

function renderResults(result) {
  var area = document.getElementById('results-area');
  var errors = result.errors;
  var warnings = result.warnings;
  var checkedCount = result.checkedCount;
  var validCount = result.validCount;
  var isValid = errors.length === 0;

  var engineTag = actualEngine === 'python' ? ' (Python)' : ' (JS)';

  showStatus(
    isValid ? 'valid' : 'invalid',
    isValid
      ? 'Valid \u00b7 ' + checkedCount + ' paths OK' + engineTag
      : errors.length + ' error' + (errors.length !== 1 ? 's' : '') + ' \u00b7 ' + warnings.length + ' warning' + (warnings.length !== 1 ? 's' : '') + engineTag
  );

  document.getElementById('stats-text').textContent =
    checkedCount + ' paths checked \u00b7 ' + validCount + ' valid \u00b7 ' + errors.length + ' errors \u00b7 ' + warnings.length + ' warnings';

  if (errors.length === 0 && warnings.length === 0) {
    area.innerHTML =
      '<div class="results-empty">' +
        '<div class="icon">&#10003;</div>' +
        '<div style="color: var(--green); font-weight: 700;">All paths valid!</div>' +
        '<div style="opacity:0.6">Checked ' + checkedCount + ' paths against ' + result.validPaths.length + ' valid paths in the template.</div>' +
      '</div>';
    return;
  }

  var html = '';

  if (errors.length > 0) {
    html += '<div class="section-header">Errors (' + errors.length + ')</div>';
    for (var i = 0; i < errors.length; i++) {
      var e = errors[i];
      html +=
        '<div class="error-item error-type-error" style="animation-delay:' + (i * 30) + 'ms">' +
          '<div class="error-path">' +
            '<span class="error-icon">&#10007;</span>' +
            '<code>' + escHtml(e.path) + '</code>' +
          '</div>' +
          '<div class="error-msg">' + escHtml(e.message) + '</div>';
      if (e.suggestion) {
        html +=
            '<div class="suggestion" title="Click to copy" onclick="copyText(\'' + escHtml(e.suggestion).replace(/'/g, "\\'") + '\', this)">' +
              '<span class="arrow">&rarr;</span>' +
              '<code>' + escHtml(e.suggestion) + '</code>' +
              '<button class="copy-btn">copy</button>' +
            '</div>';
      }
      html += '</div>';
    }
  }

  if (warnings.length > 0) {
    html += '<div class="section-header">Missing Required Fields (' + warnings.length + ')</div>';
    for (var w = 0; w < warnings.length; w++) {
      var warn = warnings[w];
      html +=
        '<div class="error-item error-type-warning" style="animation-delay:' + ((errors.length + w) * 30) + 'ms">' +
          '<div class="error-path warn">' +
            '<span class="error-icon">&#9888;</span>' +
            '<code>' + escHtml(warn.path) + '</code>' +
          '</div>' +
          '<div class="error-msg">' + escHtml(warn.message) + '</div>' +
        '</div>';
    }
  }

  area.innerHTML = html;
}

function renderOPTResults(result) {
  var area = document.getElementById('results-area');
  var errors = result.issues.filter(function(i) { return i.severity === 'error'; });
  var warnings = result.issues.filter(function(i) { return i.severity === 'warning'; });
  var infos = result.issues.filter(function(i) { return i.severity === 'info'; });

  var engineTag = ' (Python)';
  var templateLabel = result.template_id ? result.template_id : 'Unknown template';

  showStatus(
    result.is_valid ? 'valid' : 'invalid',
    result.is_valid
      ? 'Valid \u00b7 ' + templateLabel + engineTag
      : errors.length + ' error' + (errors.length !== 1 ? 's' : '') +
        ' \u00b7 ' + warnings.length + ' warning' + (warnings.length !== 1 ? 's' : '') + engineTag
  );

  var statsText = templateLabel;
  if (result.concept) statsText += ' \u00b7 ' + result.concept;
  statsText += ' \u00b7 ' + result.archetype_count + ' archetypes \u00b7 ' + result.node_count + ' nodes';
  document.getElementById('stats-text').textContent = statsText;

  if (result.issues.length === 0) {
    area.innerHTML =
      '<div class="results-empty">' +
        '<div class="icon">&#10003;</div>' +
        '<div style="color: var(--green); font-weight: 700;">OPT template is valid!</div>' +
        '<div style="opacity:0.6">' + templateLabel + ' \u2014 ' +
          result.archetype_count + ' archetypes, ' + result.node_count + ' nodes</div>' +
      '</div>';
    return;
  }

  var html = '';

  // Group by severity
  var groups = [
    { items: errors, label: 'Errors', severity: 'error' },
    { items: warnings, label: 'Warnings', severity: 'warning' },
    { items: infos, label: 'Info', severity: 'info' }
  ];

  var animIdx = 0;
  for (var g = 0; g < groups.length; g++) {
    var group = groups[g];
    if (group.items.length === 0) continue;

    html += '<div class="section-header">' + group.label + ' (' + group.items.length + ')</div>';

    for (var i = 0; i < group.items.length; i++) {
      var issue = group.items[i];
      var itemClass = 'error-type-' + group.severity;
      var iconChar = group.severity === 'error' ? '&#10007;' : group.severity === 'warning' ? '&#9888;' : '&#9432;';
      var pathClass = group.severity === 'warning' ? ' warn' : group.severity === 'info' ? ' warn' : '';

      html +=
        '<div class="error-item ' + itemClass + '" style="animation-delay:' + (animIdx * 30) + 'ms">' +
          '<div class="issue-meta">' +
            '<span class="category-badge ' + escHtml(issue.category) + '">' + escHtml(issue.category) + '</span>' +
            '<span class="issue-code">' + escHtml(issue.code) + '</span>' +
          '</div>' +
          '<div class="error-path' + pathClass + '">' +
            '<span class="error-icon">' + iconChar + '</span>' +
            '<code>' + escHtml(issue.message) + '</code>' +
          '</div>';

      if (issue.xpath) {
        html += '<div class="issue-xpath">XPath: ' + escHtml(issue.xpath) + '</div>';
      }
      if (issue.node_id) {
        html += '<div class="issue-xpath">Node: ' + escHtml(issue.node_id) +
          (issue.archetype_id ? ' in ' + escHtml(issue.archetype_id) : '') + '</div>';
      }
      if (issue.suggestion) {
        html +=
          '<div class="suggestion" title="Click to copy" onclick="copyText(\'' + escHtml(issue.suggestion).replace(/'/g, "\\'") + '\', this)">' +
            '<span class="arrow">&rarr;</span>' +
            '<code>' + escHtml(issue.suggestion) + '</code>' +
            '<button class="copy-btn">copy</button>' +
          '</div>';
      }

      html += '</div>';
      animIdx++;
    }
  }

  area.innerHTML = html;
}

function renderExplorer(validPaths) {
  var list = document.getElementById('explorer-list');
  var seen = {};
  var unique = [];
  for (var i = 0; i < validPaths.length; i++) {
    var p = validPaths[i].path;
    if (!seen[p]) { seen[p] = true; unique.push(validPaths[i]); }
  }
  unique.sort(function(a, b) { return a.path < b.path ? -1 : a.path > b.path ? 1 : 0; });

  var html = '';
  for (var j = 0; j < unique.length; j++) {
    var item = unique[j];
    var rmType = item.rmType || '';
    html += '<div class="explorer-path" data-path="' + escHtml(item.path) + '">' +
      '<span>' + escHtml(item.path) + '</span>';
    if (rmType) {
      html += '<span class="type-tag">' + escHtml(rmType.replace('DV_','')) + '</span>';
    }
    html += '</div>';
  }
  list.innerHTML = html;
}

function filterPaths() {
  var q = document.getElementById('explorer-search').value.toLowerCase();
  var els = document.querySelectorAll('.explorer-path');
  for (var i = 0; i < els.length; i++) {
    var el = els[i];
    var path = el.getAttribute('data-path') || '';
    var match = path.toLowerCase().indexOf(q) !== -1;
    el.style.display = match ? 'flex' : 'none';
    el.classList.toggle('highlighted', q !== '' && match);
  }
}

function toggleExplorer() {
  explorerOpen = !explorerOpen;
  document.getElementById('explorer-panel').classList.toggle('open', explorerOpen);
  document.getElementById('explorer-toggle').textContent =
    explorerOpen ? 'Hide valid paths' : 'Show valid paths';
}

function showStatus(type, text) {
  var pill = document.getElementById('status-pill');
  var textEl = document.getElementById('status-text');
  pill.className = 'status-pill ' + type;
  textEl.textContent = text;
}

function showError(msg) {
  document.getElementById('results-area').innerHTML =
    '<div class="results-empty">' +
      '<div class="icon">&#9888;</div>' +
      '<div style="color: var(--red);">' + escHtml(msg) + '</div>' +
    '</div>';
  showStatus('invalid', 'Parse error');
}

function copyText(text, el) {
  navigator.clipboard.writeText(text).then(function() {
    var btn = el.querySelector('.copy-btn');
    if (btn) { btn.textContent = 'copied!'; setTimeout(function() { btn.textContent = 'copy'; }, 1500); }
  });
}

function escHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function updateCounts() {
  var wt = document.getElementById('wt-input').value;
  var flat = document.getElementById('flat-input').value;
  var opt = document.getElementById('opt-input').value;
  var migSrc = document.getElementById('migration-source').value;
  var migOut = document.getElementById('migration-output').value;
  document.getElementById('wt-count').textContent = wt ? wt.split('\n').length + ' lines' : '';
  document.getElementById('flat-count').textContent = flat ? flat.split('\n').length + ' lines' : '';
  document.getElementById('opt-count').textContent = opt ? opt.split('\n').length + ' lines' : '';
  document.getElementById('migration-source-count').textContent = migSrc ? migSrc.split('\n').length + ' lines' : '';
  document.getElementById('migration-output-count').textContent = migOut ? migOut.split('\n').length + ' lines' : '';
}

// Keyboard shortcut
document.addEventListener('keydown', function(e) {
  if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
    e.preventDefault();
    runValidation();
  }
});

// ============================================================
// === MIGRATION ENGINE ===
// ============================================================

var CONTEXT_MAP = {
  'ctx/language': { path: '{treeId}/language|code', extra: {'{treeId}/language|terminology': 'ISO_639-1'} },
  'ctx/territory': { path: '{treeId}/territory|code', extra: {'{treeId}/territory|terminology': 'ISO_3166-1'} },
  'ctx/composer_name': { path: '{treeId}/composer|name' },
  'ctx/composer_id': { path: '{treeId}/composer|id' },
  'ctx/time': { path: '{treeId}/context/start_time' },
  'ctx/end_time': { path: '{treeId}/context/end_time' },
  'ctx/category': { path: '{treeId}/category|code', extra: {'{treeId}/category|value': 'event', '{treeId}/category|terminology': 'openehr'} },
  'ctx/health_care_facility|name': { path: '{treeId}/context/health_care_facility|name' },
  'ctx/health_care_facility|id': { path: '{treeId}/context/health_care_facility|id' },
  'ctx/id_namespace': { path: '{treeId}/id_namespace' },
  'ctx/id_scheme': { path: '{treeId}/id_scheme' },
  'ctx/setting|code': { path: '{treeId}/context/setting|code' },
  'ctx/setting|value': { path: '{treeId}/context/setting|value' },
  'ctx/setting|terminology': { path: '{treeId}/context/setting|terminology' },
};

function detectTreeId(flatComposition) {
  var prefixes = {};
  var keys = Object.keys(flatComposition);
  for (var i = 0; i < keys.length; i++) {
    if (keys[i].startsWith('ctx/')) continue;
    var firstSegment = keys[i].split('/')[0].split(':')[0];
    prefixes[firstSegment] = (prefixes[firstSegment] || 0) + 1;
  }
  var best = null, bestCount = 0;
  for (var p in prefixes) {
    if (prefixes[p] > bestCount) { bestCount = prefixes[p]; best = p; }
  }
  return best || 'composition';
}

function autoDetectSourcePlatform(flatComposition) {
  var keys = Object.keys(flatComposition);
  var hasCtx = keys.some(function(k) { return k.startsWith('ctx/'); });
  var hasAnyEvent = keys.some(function(k) { return k.includes('/any_event:'); });

  if (hasCtx || hasAnyEvent) return 'better';
  return 'ehrbase';
}

// Build reverse context map: EHRBase path pattern -> ctx/ key
function buildReverseContextMap(treeId) {
  var reverse = {};
  for (var ctxKey in CONTEXT_MAP) {
    var entry = CONTEXT_MAP[ctxKey];
    var ehrbasePath = entry.path.replace(/\{treeId\}/g, treeId);
    reverse[ehrbasePath] = { ctxKey: ctxKey, extra: entry.extra };
    // Also track extra fields so we know to drop them
    if (entry.extra) {
      for (var extraKey in entry.extra) {
        var resolvedExtra = extraKey.replace(/\{treeId\}/g, treeId);
        reverse[resolvedExtra] = { ctxKey: null, dropField: true };
      }
    }
  }
  return reverse;
}

function convertEhrbaseToBetter(flatComposition) {
  var treeId = detectTreeId(flatComposition);
  var result = {};
  var changes = [];
  var reverseMap = buildReverseContextMap(treeId);
  var keys = Object.keys(flatComposition);

  for (var i = 0; i < keys.length; i++) {
    var key = keys[i];
    var value = flatComposition[key];

    // Check if this is a context field that maps to ctx/
    if (reverseMap[key]) {
      var mapping = reverseMap[key];
      if (mapping.dropField) {
        // This is an extra field (e.g. language|terminology) — drop it
        changes.push({ original: key, converted: '(dropped)', category: 'CONTEXT_PREFIX', rule: 'Implicit in Better format' });
        continue;
      }
      if (mapping.ctxKey) {
        result[mapping.ctxKey] = value;
        changes.push({ original: key, converted: mapping.ctxKey, category: 'CONTEXT_PREFIX', rule: 'EHRBase tree path to Better ctx/ prefix' });
        continue;
      }
    }

    // For non-context paths: add :0 indexing and any_event insertion
    var newKey = key;
    var changeCategories = [];

    // Split on | to separate path from attribute suffix
    var pipeIdx = newKey.indexOf('|');
    var pathPart = pipeIdx >= 0 ? newKey.substring(0, pipeIdx) : newKey;
    var attrPart = pipeIdx >= 0 ? newKey.substring(pipeIdx) : '';

    // Split path into segments
    var segments = pathPart.split('/');
    var newSegments = [];
    var addedAnyEvent = false;

    for (var s = 0; s < segments.length; s++) {
      var seg = segments[s];
      var isLast = (s === segments.length - 1);
      var isFirst = (s === 0); // tree ID, don't index

      // Add :0 to non-leaf, non-first segments that don't already have an index
      if (!isFirst && !isLast && !/:/.test(seg)) {
        seg = seg + ':0';
        if (!changeCategories.includes('INDEX_NOTATION')) changeCategories.push('INDEX_NOTATION');
      }

      newSegments.push(seg);

      // any_event:0 insertion heuristic: without template metadata we cannot
      // reliably know whether a node is OBSERVATION-backed (has events) or is
      // an EVALUATION/INSTRUCTION/etc.  Mark the path as ambiguous instead of
      // blindly inserting any_event:0 — unless we have positive evidence.
      if (!isFirst && !isLast && s < segments.length - 1 && s === 1) {
        var nextSeg = segments[s + 1];
        var NON_EVENT_CHILDREN = ['context','language','territory','composer',
          'category','encoding','subject','time','ism_transition','narrative',
          'expiry_time','description','current_state','careflow_step','timing'];
        var isNextNonEvent = NON_EVENT_CHILDREN.some(function(c) { return nextSeg.startsWith(c); });
        if (!nextSeg.startsWith('any_event') && !isNextNonEvent) {
          // No template context available — flag as ambiguous so the user can verify
          if (!changeCategories.includes('AMBIGUOUS_PATH')) changeCategories.push('AMBIGUOUS_PATH');
        }
      }
    }

    newKey = newSegments.join('/') + attrPart;

    if (newKey !== key) {
      var cats = changeCategories.length > 0 ? changeCategories.join(', ') : 'INDEX_NOTATION';
      changes.push({ original: key, converted: newKey, category: cats, rule: changeCategories.join(' + ') });
    } else {
      changes.push({ original: key, converted: newKey, category: 'UNCHANGED', rule: '' });
    }

    result[newKey] = value;
  }

  return { output: result, changes: changes, treeId: treeId };
}

function convertBetterToEhrbase(flatComposition) {
  var treeId = detectTreeId(flatComposition);
  var result = {};
  var changes = [];
  var keys = Object.keys(flatComposition);

  for (var i = 0; i < keys.length; i++) {
    var key = keys[i];
    var value = flatComposition[key];

    // Check if this is a ctx/ field
    if (key.startsWith('ctx/')) {
      var ctxEntry = CONTEXT_MAP[key];
      if (ctxEntry) {
        var ehrbasePath = ctxEntry.path.replace(/\{treeId\}/g, treeId);
        result[ehrbasePath] = value;
        changes.push({ original: key, converted: ehrbasePath, category: 'CONTEXT_PREFIX', rule: 'Better ctx/ to EHRBase tree path' });
        // Add extra fields
        if (ctxEntry.extra) {
          for (var extraKey in ctxEntry.extra) {
            var resolvedKey = extraKey.replace(/\{treeId\}/g, treeId);
            var extraVal = ctxEntry.extra[extraKey];
            // For category, use the actual value if ctx/category was provided
            if (key === 'ctx/category' && resolvedKey.indexOf('|value') >= 0) {
              extraVal = value;
            }
            result[resolvedKey] = extraVal;
            changes.push({ original: '(added)', converted: resolvedKey, category: 'CONTEXT_PREFIX', rule: 'Extra field for EHRBase' });
          }
        }
      } else {
        // Unknown ctx/ field, pass through
        result[key] = value;
        changes.push({ original: key, converted: key, category: 'UNCHANGED', rule: '' });
      }
      continue;
    }

    // For non-context paths: remove :0 indexing and any_event:0 segments
    var newKey = key;
    var changeCategories = [];

    // Remove /any_event:N/ segments (any index, not just :0)
    if (/\/any_event:\d+\//.test(newKey)) {
      newKey = newKey.replace(/\/any_event:\d+\//g, '/');
      if (!changeCategories.includes('PATH_STRUCTURE')) changeCategories.push('PATH_STRUCTURE');
    }
    // Also handle /any_event:N| at end of path
    if (/\/any_event:\d+\|/.test(newKey)) {
      newKey = newKey.replace(/\/any_event:\d+\|/g, '|');
      if (!changeCategories.includes('PATH_STRUCTURE')) changeCategories.push('PATH_STRUCTURE');
    }
    // Handle /any_event:N at end of path (no | suffix)
    if (/\/any_event:\d+$/.test(newKey)) {
      newKey = newKey.replace(/\/any_event:\d+$/, '');
      if (!changeCategories.includes('PATH_STRUCTURE')) changeCategories.push('PATH_STRUCTURE');
    }

    // Remove :0 from path segments (keep :1, :2, etc.)
    var beforeIndex = newKey;
    newKey = newKey.replace(/:0(?=\/|$|\|)/g, '');
    if (newKey !== beforeIndex) {
      changeCategories.push('INDEX_NOTATION');
    }

    if (newKey !== key) {
      var cats = changeCategories.join(', ');
      changes.push({ original: key, converted: newKey, category: cats, rule: changeCategories.join(' + ') });
    } else {
      changes.push({ original: key, converted: newKey, category: 'UNCHANGED', rule: '' });
    }

    result[newKey] = value;
  }

  return { output: result, changes: changes, treeId: treeId };
}

function runMigrationFlow() {
  var sourceRaw = document.getElementById('migration-source').value.trim();
  if (!sourceRaw) {
    showStatus('idle', 'Please provide a FLAT composition to convert');
    return;
  }

  var sourceObj;
  try { sourceObj = JSON.parse(sourceRaw); } catch(e) {
    showError('FLAT Composition JSON is invalid: ' + e.message);
    return;
  }

  var convResult;
  if (migrationSource === 'ehrbase') {
    convResult = convertEhrbaseToBetter(sourceObj);
  } else {
    convResult = convertBetterToEhrbase(sourceObj);
  }

  // Show output
  document.getElementById('migration-output').value = JSON.stringify(convResult.output, null, 2);
  updateCounts();

  // Count changes
  var changed = 0, unchanged = 0;
  for (var c = 0; c < convResult.changes.length; c++) {
    if (convResult.changes[c].category === 'UNCHANGED') unchanged++;
    else changed++;
  }
  var total = convResult.changes.length;

  showStatus('valid', total + ' paths converted');
  document.getElementById('stats-text').textContent =
    total + ' paths converted \u00b7 ' + changed + ' changed \u00b7 ' + unchanged + ' unchanged';

  // Render change report
  renderChangeReport(convResult.changes);
}

function renderChangeReport(changes) {
  var area = document.getElementById('results-area');

  // Group by category
  var groups = {};
  var groupOrder = ['CONTEXT_PREFIX', 'INDEX_NOTATION', 'PATH_STRUCTURE', 'AMBIGUOUS_PATH', 'UNCHANGED'];
  for (var i = 0; i < changes.length; i++) {
    var ch = changes[i];
    var cats = ch.category.split(', ');
    for (var ci = 0; ci < cats.length; ci++) {
      var cat = cats[ci];
      if (!groups[cat]) groups[cat] = [];
      groups[cat].push(ch);
    }
  }

  // Count summary
  var changed = 0, unchanged = 0;
  for (var j = 0; j < changes.length; j++) {
    if (changes[j].category === 'UNCHANGED') unchanged++;
    else changed++;
  }

  var html = '<div class="change-report-summary">' +
    changes.length + ' paths converted &middot; ' + changed + ' changed &middot; ' + unchanged + ' unchanged</div>';

  html += '<div class="change-report">';

  var groupLabels = {
    'CONTEXT_PREFIX': 'Context Prefix',
    'INDEX_NOTATION': 'Index Notation',
    'PATH_STRUCTURE': 'Path Structure',
    'AMBIGUOUS_PATH': 'Ambiguous Path (may need any_event:0 — verify with template)',
    'UNCHANGED': 'Unchanged'
  };

  for (var g = 0; g < groupOrder.length; g++) {
    var gKey = groupOrder[g];
    if (!groups[gKey] || groups[gKey].length === 0) continue;

    html += '<div class="change-category">';
    html += '<div class="change-category-header">' + groupLabels[gKey] + ' (' + groups[gKey].length + ')</div>';

    for (var k = 0; k < groups[gKey].length; k++) {
      var item = groups[gKey][k];
      if (item.category === 'UNCHANGED') {
        html += '<div class="change-item">' +
          '<span class="diff-unchanged">' + escHtml(item.original) + '</span>' +
          '</div>';
      } else {
        html += '<div class="change-item">' +
          '<span class="diff-removed">' + escHtml(item.original) + '</span>' +
          '<span class="change-arrow">&rarr;</span>' +
          '<span class="diff-added">' + escHtml(item.converted) + '</span>' +
          '</div>';
      }
    }

    html += '</div>';
  }

  html += '</div>';
  area.innerHTML = html;
}

function setMigrationSource(source) {
  migrationSource = source;
  migrationTarget = source === 'ehrbase' ? 'better' : 'ehrbase';
  document.getElementById('btn-migration-ehrbase').classList.toggle('active', source === 'ehrbase');
  document.getElementById('btn-migration-better').classList.toggle('active', source === 'better');
  document.getElementById('btn-migration-target-ehrbase').classList.toggle('active', migrationTarget === 'ehrbase');
  document.getElementById('btn-migration-target-better').classList.toggle('active', migrationTarget === 'better');
}

function swapMigrationPlatforms() {
  setMigrationSource(migrationTarget);
}

function autoDetectPlatform() {
  var sourceRaw = document.getElementById('migration-source').value.trim();
  if (!sourceRaw) {
    showToast('Paste a FLAT composition first, then auto-detect', 'warn', 3000);
    return;
  }
  var sourceObj;
  try { sourceObj = JSON.parse(sourceRaw); } catch(e) {
    showToast('Invalid JSON \u2014 cannot auto-detect', 'warn', 3000);
    return;
  }
  var detected = autoDetectSourcePlatform(sourceObj);
  setMigrationSource(detected);
  showToast('Detected source platform: ' + (detected === 'ehrbase' ? 'EHRBase 2.x' : 'Better'), '', 3000);
}

function copyMigrationOutput() {
  var output = document.getElementById('migration-output').value;
  if (!output) {
    showToast('No output to copy', 'warn', 2000);
    return;
  }
  navigator.clipboard.writeText(output).then(function() {
    showToast('Copied to clipboard', '', 2000);
  });
}

